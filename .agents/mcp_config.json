{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "figma": {
            "serverUrl": "https://mcp.figma.com/mcp",
            "headers": {
                "Authorization": "Bearer YOUR_FIGMA_TOKEN",
                "X-Figma-Token": "YOUR_FIGMA_TOKEN"
            }
        },
        "figma-developer": {
            "command": "cmd",
            "args": [
                "/c",
                "npx -y figma-developer-mcp"
            ],
            "env": {
                "FIGMA_API_KEY": "YOUR_FIGMA_TOKEN",
                "FIGMA_PERSONAL_ACCESS_TOKEN": "YOUR_FIGMA_TOKEN"
            }
        }
    }
}
